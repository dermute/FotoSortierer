<Application x:Class="FotoSortierer.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#20342F" />
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#F5F5F0"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="40"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="#E8EDE7"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  </Application.Resources>
</Application>
